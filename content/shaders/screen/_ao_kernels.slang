#pragma once

// ============================================================================
// ЯДРА ВЫБОРКИ SSAO
// ============================================================================

// Количество вариантов ядер и максимальное количество выборок в ядре
static const uint KERNEL_COUNT = 4;
static const uint MAX_KERNEL_SIZE = 16;

// Размеры ядер для каждого варианта (2, 4, 8 и 16 выборок)
static const uint SSAO_KERNEL_SIZES[KERNEL_COUNT] = { 2, 4, 8, 16 };

// Константные ядра выборки направлений в касательном пространстве (полусфера Z > 0).
// Векторы распределены внутри единичной полусферы вокруг нормали (ось Z) с ускоряющимся
// шагом длины от центра к краям (интенсивнее проверяем точки вблизи самой поверхности).
// При этом минимальный угол к плоскости поверхности ограничен (Z >= 0.15), чтобы избежать
// ложного само-затенения (self-occlusion) на плоских гранях.
static const float3 SSAO_KERNELS[KERNEL_COUNT][MAX_KERNEL_SIZE] =
{
    // Вариант 0: 2 сэмпла (2 противоположных квадранта на ближней и средней дистанциях)
    {
        float3( 0.1482,  0.0916,  0.1362),
        float3(-0.1490, -0.3685,  0.2845),

        float3(0.0, 0.0, 0.0),
        float3(0.0, 0.0, 0.0),

        float3(0.0, 0.0, 0.0),
        float3(0.0, 0.0, 0.0),
        float3(0.0, 0.0, 0.0),
        float3(0.0, 0.0, 0.0),

        float3(0.0, 0.0, 0.0),
        float3(0.0, 0.0, 0.0),
        float3(0.0, 0.0, 0.0),
        float3(0.0, 0.0, 0.0),

        float3(0.0, 0.0, 0.0),
        float3(0.0, 0.0, 0.0),
        float3(0.0, 0.0, 0.0),
        float3(0.0, 0.0, 0.0)
    },

    // Вариант 1: 4 сэмпла (по 1 точке в каждом квадранте и радиальном слое)
    {
        float3( 0.1482,  0.0916,  0.1362),
        float3(-0.2712,  0.1740,  0.2385),
        float3(-0.1490, -0.3685,  0.2845),
        float3( 0.0785, -0.5120,  0.3890),

        float3(0.0, 0.0, 0.0),
        float3(0.0, 0.0, 0.0),
        float3(0.0, 0.0, 0.0),
        float3(0.0, 0.0, 0.0),

        float3(0.0, 0.0, 0.0),
        float3(0.0, 0.0, 0.0),
        float3(0.0, 0.0, 0.0),
        float3(0.0, 0.0, 0.0),

        float3(0.0, 0.0, 0.0),
        float3(0.0, 0.0, 0.0),
        float3(0.0, 0.0, 0.0),
        float3(0.0, 0.0, 0.0)
    },

    // Вариант 2: 8 сэмплов (по 2 точки в каждом квадранте и радиальном слое)
    {
        float3(-0.0714,  0.0583,  0.1054),
        float3( 0.1482,  0.0916,  0.1362),
        float3(-0.1945, -0.0841,  0.1685),
        float3( 0.1620, -0.1984,  0.1890),

        float3( 0.3410, -0.0562,  0.2690),
        float3(-0.4415,  0.0420,  0.3480),
        float3(-0.3820, -0.3910,  0.4250),
        float3( 0.5140,  0.2680,  0.4820),

        float3(0.0, 0.0, 0.0),
        float3(0.0, 0.0, 0.0),
        float3(0.0, 0.0, 0.0),
        float3(0.0, 0.0, 0.0),

        float3(0.0, 0.0, 0.0),
        float3(0.0, 0.0, 0.0),
        float3(0.0, 0.0, 0.0),
        float3(0.0, 0.0, 0.0)
    },

    // Вариант 3: 16 сэмплов (полное ядро)
    {
        float3( 0.0380,  0.0252,  0.0891),
        float3(-0.0714,  0.0583,  0.1054),
        float3( 0.0195, -0.1328,  0.1147),
        float3( 0.1482,  0.0916,  0.1362),

        float3(-0.1945, -0.0841,  0.1685),
        float3( 0.1620, -0.1984,  0.1890),
        float3(-0.0683,  0.2815,  0.2140),
        float3(-0.2712,  0.1740,  0.2385),

        float3( 0.3410, -0.0562,  0.2690),
        float3(-0.1490, -0.3685,  0.2845),
        float3( 0.2580,  0.3512,  0.3120),
        float3(-0.4415,  0.0420,  0.3480),

        float3( 0.0785, -0.5120,  0.3890),
        float3(-0.3820, -0.3910,  0.4250),
        float3( 0.5140,  0.2680,  0.4820),
        float3(-0.2460,  0.6150,  0.5640)
    }
};

/**
 * @brief Возвращает индекс ядра выборки SSAO на основании заданного количества сэмплов.
 * @details Если samples >= количества точек в ядре, выбирается это ядро, иначе — ядро с меньшим числом сэмплов.
 * @param[in] samples Запрошенное количество выборок.
 * @return Индекс ядра в массиве SSAO_KERNELS [0..KERNEL_COUNT - 1].
 */
[ForceInline]
uint get_kernel_index(uint samples)
{
    return (samples >= 16) ? 3 : ((samples >= 8) ? 2 : ((samples >= 4) ? 1 : 0));
}

/**
 * @brief Возвращает размер ядра выборки SSAO (количество активных точек) на основании заданного количества сэмплов.
 * @param[in] samples Запрошенное количество выборок.
 * @return Количество сэмплов в выбранном ядре (2, 4, 8 или 16).
 */
[ForceInline]
uint get_kernel_size(uint samples)
{
    return SSAO_KERNEL_SIZES[get_kernel_index(samples)];
}
