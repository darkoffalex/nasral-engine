# Blender 4.3.2 MTL File: 'floor.blend'
# www.blender.org

newmtl Floor
Ka 1.000000 1.000000 1.000000
Ks 0.500000 0.500000 0.500000
Ke 0.000000 0.000000 0.000000
Ni 1.450000
d 1.000000
illum 2
map_Kd ../textures/floor/floor_diff.png
map_Ns ../textures/floor/floor_rough.png
map_bump -bm 1.000000 ../textures/floor/floor_nor.png

newmtl Walls
Ka 1.000000 1.000000 1.000000
Ks 0.500000 0.500000 0.500000
Ke 0.000000 0.000000 0.000000
Ni 1.500000
d 1.000000
illum 2
map_Kd ../textures/floor/brick_diff.png
map_Ns ../textures/floor/brick_rough.png
map_bump -bm 1.000000 ../textures/floor/brick_nor.png
